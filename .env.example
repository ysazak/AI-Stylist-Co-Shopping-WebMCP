# Server-side Gemini API key for Virtual Fit
GEMINI_API_KEY=your_google_ai_studio_key_here

# Gemini image model used for virtual try-on (defaults to gemini-3.1-flash-lite-image if unset)
GEMINI_TRY_ON_MODEL=gemini-3.1-flash-lite-image

# Public ChatGPT destination (must be an absolute HTTPS URL)
NEXT_PUBLIC_CHATGPT_URL=
